# FieldStaff AI Biometric Attendance Backend Environment Config
PROJECT_NAME="FieldStaff AI Biometric Attendance"
ENV="development"
DEBUG=true

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fieldstaff_attendance_db

# Security & JWT
JWT_SECRET_KEY=fieldstaff_super_secret_jwt_key_change_in_production_2026_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Biometric & ML Inference
ML_WEIGHTS_DIR=./weights
FACE_DETECTOR_MODEL=scrfd_2.5g_bnkps.onnx
FACE_RECOGNITION_MODEL=w600k_r50.onnx
ANTI_SPOOFING_MODEL=2.7_80x80_MiniFASNetV2.onnx
SIMILARITY_THRESHOLD=0.65
LIVENESS_CONFIDENCE_THRESHOLD=0.70
MIN_FACE_SIZE=80

# GPS & Geofencing
MAX_GPS_ACCURACY_THRESHOLD_METERS=50.0

# CORS Origins (comma-separated)
CORS_ORIGINS=*
